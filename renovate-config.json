{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>uinaf/renovate-config"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "uinaf/.github"
      ],
      "enabled": true
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true,
      "automerge": false
    }
  ]
}
